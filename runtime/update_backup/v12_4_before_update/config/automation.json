{
  "schema_version": 1,
  "morning_automation": {
    "enabled": true,
    "start_time": "07:00",
    "end_time": "09:30",
    "trigger": "first_unlock_seen",
    "once_per_day": true,
    "show_popup": true,
    "late_prompt_after_window": true,
    "actions": [
      "system_health",
      "pending_tasks",
      "briefing"
    ]
  },
  "health_monitor": {
    "enabled": true,
    "scan_seconds": 15,
    "ram_warning_percent": 80,
    "ram_critical_percent": 92,
    "cpu_warning_percent": 85,
    "cpu_sustain_seconds": 120,
    "disk_warning_free_gb": 15,
    "disk_critical_free_gb": 5,
    "detect_hung_windows": true,
    "detect_suspended_processes": true,
    "max_process_alerts": 5
  },
  "windows_startup": {
    "enabled_by_default": true,
    "start_hidden": true,
    "single_instance": true,
    "notify_background_alerts": true
  }
}
