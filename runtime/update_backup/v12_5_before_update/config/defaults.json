    "start_time": "07:00",
    "end_time": "09:30",
    "trigger": "first_unlock_seen"
  },
  "privacy": {
    "learning_is_local": true,
    "capture_keystrokes": false,
    "observe_private_content": false,
    "automatic_sensitive_actions": false
  }
}
